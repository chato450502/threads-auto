# ============================================================
# Threads 自動投稿システム 環境変数サンプル
# ローカルでドライラン等を試すとき、これを .env にコピーして値を入れる。
# GitHub Actions 上では .env は使わず、Secrets から環境変数で渡す。
# ============================================================

# --- 投稿に必須（publish.py） ---
# ThreadsのユーザーID（数値。Graph APIの /me?fields=id で取得できる）
THREADS_USER_ID=

# 長期アクセストークン（src/get_token.py で取得。READMEの手順参照）
THREADS_ACCESS_TOKEN=

# --- 長期トークン取得ヘルパー（src/get_token.py）用 ---
# アプリの設定→ベーシック の値。REDIRECT はアプリに登録したものと完全一致
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://localhost/

# Graph APIのベースURL（通常は変更不要）
GRAPH_API_BASE=https://graph.threads.net/v1.0

# --- 動作モード ---
# true で実際には投稿しないドライラン（--dry-run フラグでも可）
DRY_RUN=false

# 文字数カウント方式: graphemes（既定・絵文字=1）/ codepoints / bytes
LENGTH_MODE=graphemes

# コンテナ作成〜公開の待機秒数（仕様は30。テスト時のみ短縮可）
POST_WAIT_SECONDS=30

# 予定時刻を過ぎた枠を拾う許容窓（分）。cronの遅延・スキップ耐性。既定360=6時間
CATCHUP_MINUTES=360

# --- 下書き生成（generate.py） ---
# Claude API キー（https://console.anthropic.com で取得）
ANTHROPIC_API_KEY=
# 生成に使うモデル
GENERATE_MODEL=claude-sonnet-4-6

# --- 監視通知（任意） ---
# Discord または Slack の Incoming Webhook URL（未設定なら Summary のみ）
NOTIFY_WEBHOOK_URL=

# --- トークンリフレッシュ用（refresh_token.py） ---
# Secretsを書き換えられるGitHub PAT（Fine-grained: Secrets=Read and write）
GH_PAT=
# "owner/repo"。GitHub Actions上では自動で入るのでローカルテスト時のみ設定
GITHUB_REPOSITORY=
# 更新先のSecret名（通常このまま）
THREADS_TOKEN_SECRET_NAME=THREADS_ACCESS_TOKEN
